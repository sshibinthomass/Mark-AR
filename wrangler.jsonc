{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mark-ar-targets",
  "main": "worker/src/index.ts",
  "workers_dev": true,
  "preview_urls": true,
  "compatibility_date": "2026-07-25",
  "vars": {
    "PUBLIC_ORIGIN": "https://mark-ar-targets.example.workers.dev"
  },
  "r2_buckets": [
    {
      "binding": "ASSET_BUCKET",
      "bucket_name": "mark-ar-assets"
    }
  ]
}
